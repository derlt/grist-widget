# ── Grist Plugin Discovery ──
# Base path for user plugins; Grist scans $GRIST_USER_ROOT/plugins/
GRIST_USER_ROOT=/grist/user

# Optional: enable experimental plugins (not needed here, but available)
# GRIST_EXPERIMENTAL_PLUGINS=true

# ── Home server ──
# Set to the URL of your Grist instance
# GRIST_HOST=0.0.0.0
# PORT=8484

# ── Database ──
# GRIST_DOCS_DATABASE_URL=postgres://user:pass@db:5432/grist
# REDUX_SQLITE_URL=/persist/docs

# ── Secrets ──
# GRIST_SECRET=change-me-to-a-random-string
